# === 服务模式 ===
ENV=development

# === 服务模式（契约 11.9：评委 clone 即可跑的安全默认）===
# mock 保证无外部凭据也能跑通全链路；配好 key 后改 real 即走真实链路
PAYMENT_MODE=mock            # mock | real
LLM_MODE=mock                # mock | real

# === LLM 配置（OpenAI 兼容接口，任意官方端点均可）===
# 契约裁决（11.5）：本机用 qwen 平台（DashScope OpenAI 兼容端点），
# 备选智谱 GLM-5.3-Flash（open.bigmodel.cn/api/paas/v4）。
# 官方直连、可注册、不峰谷——录视频要可重复。
LLM_API_KEY=
LLM_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
LLM_TIMEOUT_SECONDS=45
LLM_APP_NAME=AI Desktop Agent
LLM_HTTP_REFERER=http://localhost:3000
LLM_MIN_INTERVAL_SECONDS=3.5
LLM_CACHE_TTL_SECONDS=180
LLM_CACHE_MAX_ENTRIES=128
LLM_REVIEW_ENABLED=false

# === PayPal（契约 11.9）===
# sandbox 凭据在 https://developer.paypal.com 的 Apps & Credentials 创建
PAYPAL_MODE=sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_SECRET=
PAYPAL_SANDBOX_API=https://api-m.sandbox.paypal.com

# === 多 Provider API Keys ===
# providers.json 中通过 ${VAR_NAME} 引用这些环境变量
OPENROUTER_API_KEY=your_openrouter_key_here
ZHIPU_API_KEY=your_zhipu_key_here
MINIMAX_API_KEY=your_minimax_key_here

# === API 认证（可选）===
# 设置 API_KEY 后，所有 API 调用需要携带 X-API-Key header
# API_KEY=your-secret-api-key

# === CORS 配置 ===
# 开发环境前端地址（多个用逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 开发环境是否允许所有来源（true=允许，false=使用上面列表）
CORS_ALLOW_ALL=true

# 真实语音链路：后端应用调用本地 Voice Bridge，Bridge 再转发到 OpenAI 兼容语音接口
VOICE_PROVIDER=openai
VOICE_API_KEY=local-voice-bridge
VOICE_BASE_URL=http://127.0.0.1:5050/v1
VOICE_STT_MODEL=gpt-4o-mini-transcribe
VOICE_TTS_MODEL=tts-1
VOICE_TTS_VOICE=alloy
VOICE_TIMEOUT_SECONDS=60

# Voice Bridge 上游配置（建议单独放在启动命令环境变量里）
OPENAI_API_KEY=none
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
OPENAI_TIMEOUT_SECONDS=90
VOICE_BRIDGE_PORT=5050

# === LangFuse 可观测性 ===
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# === RAG 配置（离线优先，运行时不自动下载模型）===
# RAG_STORE_DIR=          # leave commented to use default (~/.ecv_rag_store)
RAG_EMBEDDING_MODEL_PATH=all-MiniLM-L6-v2
RAG_AUTO_BUILD_FAISS=true
RAG_CHUNK_TTL_DAYS=365

# RAG Rerank (cross-encoder, offline local model only)
RAG_RERANK_ENABLED=false
# RAG_RERANK_MODEL_PATH=./models/bge-reranker-base

# === Fast Brain (Ollama) ===
FAST_BRAIN_ENABLED=false
OLLAMA_HOST=http://127.0.0.1:11434
FAST_BRAIN_MODEL=qwen3:1.7b
FAST_BRAIN_HIGH_THRESHOLD=0.92
FAST_BRAIN_MID_THRESHOLD=0.7

# Hackathon keys are only valid against the hackathon base URL.

# === Channel3 商品搜索（支付/选品链路 L1 真实商品来源）===
# 在 https://trychannel3.com 创建 key。支付子图 taste_select 用真实商品搜索，
# key 为空/请求失败时自动降级到本地 catalog（local_ranker）。
CHANNEL3_API_KEY=your_channel3_api_key_here
# CHANNEL3_BASE_URL=                 # 留空使用 SDK 默认生产端点
CHANNEL3_TIMEOUT_SECONDS=10
CHANNEL3_MAX_RETRIES=2
# CHANNEL3_LANGUAGE=en
# CHANNEL3_COUNTRY=US
# CHANNEL3_CURRENCY=USD
# CHANNEL3_DNS_PIN=                  # 演示机 DNS 污染应急（应用层固定真实 IP，TLS 校验不放松）；
                                     # 网关把 api.trychannel3.com 的 AWS 记录解析成 127.0.0.1 时填写，
                                     # 逗号分隔；正常网络留空即走系统解析
